# Canonical corpus artifacts are byte-exact and hash-verified by
# load_canonical_document(). Git's automatic CRLF conversion would change their
# bytes on checkout (e.g. 69706 -> 70718 for rag_paper/v1.txt) and break every
# recorded text_hash and character offset. Never convert line endings here.
/data/corpus/canonical/** -text
/data/corpus/documents.jsonl text eol=lf

# Locked reannotation hashes cover exact input and output bytes, including
# Markdown rules and JSONL line endings. Preserve them on every platform;
# archived source whitespace is checked by hashes, not formatting rules.
/data/eval/reannotation-20260923/** -text -whitespace
/data/eval/reannotation.jsonl -text

# Preserve the original mixed-newline frozen QA bytes; never reserialize it.
/data/eval/qa.jsonl -text -whitespace
# New audit artifacts have a portable byte representation.
/results/audits/2026-09-23-fixes/** text eol=lf

/scripts/rebuild_saved_audit.py text eol=lf
