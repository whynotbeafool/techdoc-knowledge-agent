{
  "pattern": "[A-Za-z0-9_]+",
  "lowercase": true,
  "stopwords": [
    "a",
    "an",
    "and",
    "are",
    "as",
    "at",
    "be",
    "by",
    "did",
    "do",
    "does",
    "for",
    "from",
    "how",
    "in",
    "is",
    "it",
    "of",
    "on",
    "or",
    "that",
    "the",
    "this",
    "to",
    "was",
    "were",
    "what",
    "when",
    "where",
    "which",
    "who",
    "why",
    "with"
  ],
  "formula": "number of unique question content tokens present in the union of evidence quote content tokens / number of unique question content tokens; empty denominator -> 0; round to 4 decimal places before stratification",
  "metric": "question_content_token_recall_in_evidence",
  "strata": {
    "low": "score < 0.25",
    "medium": "0.25 <= score < 0.50",
    "high": "score >= 0.50"
  }
}
